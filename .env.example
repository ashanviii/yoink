# --- required in production ---------------------------------------------------
# Domain Caddy serves and gets an HTTPS certificate for (docker-compose deploys).
DOMAIN=yoink.example.com

# Signs download tokens. 32+ random chars, e.g. `openssl rand -base64 48`.
YOINK_SECRET=

# Public origin, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://yoink.example.com
# Shown on the privacy and copyright/DMCA pages.
NEXT_PUBLIC_CONTACT_EMAIL=legal@yoink.example.com

# --- binaries (auto-detected when unset) ------------------------------------
# yt-dlp executable. Default: `yt-dlp` on PATH, then `python -m yt_dlp`.
# YTDLP_PATH=/usr/local/bin/yt-dlp
# ffmpeg executable. Default: the bundled ffmpeg-static binary.
# FFMPEG_PATH=/usr/bin/ffmpeg

# --- networking ---------------------------------------------------------------
# How to find the real client IP for per-IP rate limits (set ONE when behind a proxy):
#   Cloudflare:            YOINK_CLIENT_IP_HEADER=cf-connecting-ip
#   nginx/Caddy/Fly/etc.:  YOINK_TRUSTED_PROXY_HOPS=1   (number of proxies appending to X-Forwarded-For)
# Without either, clients can spoof X-Forwarded-For and dodge per-IP limits (global caps still hold).
# YOINK_CLIENT_IP_HEADER=
# YOINK_TRUSTED_PROXY_HOPS=
# Outbound proxy for the extractor, e.g. if a platform is blocked in your server's region.
# YTDLP_PROXY=socks5://user:pass@host:1080
# Netscape-format cookies file. Only needed for login-walled content (e.g. most
# Instagram Stories). Using a logged-in account may violate the platform's terms — your call.
# YTDLP_COOKIES_FILE=/run/secrets/cookies.txt

# --- limits -------------------------------------------------------------------
# YOINK_MAX_FILESIZE_MB=2048
# YOINK_MAX_DURATION_SEC=10800
# Fetch step (each is a yt-dlp process, ~50-100 MB RAM). Excess requests queue, then get "busy".
# YOINK_MAX_CONCURRENT_RESOLVES=6
# YOINK_MAX_QUEUED_RESOLVES=100
# YOINK_RESOLVE_QUEUE_WAIT_MS=30000
# Cache resolved links (ms). Viral links then cost one extraction. 0 disables (useful for load tests).
# YOINK_RESOLVE_CACHE_TTL_MS=300000
# Download/convert step (yt-dlp + ffmpeg; CPU and bandwidth heavy).
# YOINK_MAX_CONCURRENT_JOBS=3
# YOINK_MAX_QUEUED_JOBS=20
# YOINK_RESOLVE_TIMEOUT_MS=45000
# YOINK_DOWNLOAD_TIMEOUT_MS=900000
# YOINK_FILE_TTL_MS=600000
# YOINK_TOKEN_TTL_SEC=3600
# YOINK_TMP_DIR=/tmp
